# Production values for running the backend via docker-compose.yml on the
# self-hosted deployment target. Copy to backend/.env.production and fill in
# real values -- never commit the filled-in file.

# host.docker.internal lets the backend container reach Ollama running on the
# same host machine (outside Docker). Requires docker-compose.yml's
# extra_hosts entry on Linux; works out of the box on Docker Desktop.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest

# MongoDB Atlas free-tier connection string (see DEPLOYMENT.md step 1).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ag_ai

# Number of most-recent conversation turns (user+assistant message pairs)
# replayed to the model as context on each /api/chat call. 0 disables history.
MAX_HISTORY_TURNS=5

# Stays false even in production: Cloudflare Tunnel terminates TLS at its edge
# and forwards plain HTTP to this container. Setting this to true would make
# the backend redirect its own internal HTTP traffic and break the tunnel.
FORCE_HTTPS=false

# --- MCP tool server (specs.md Phase 8) -------------------------------------
# docker-compose.yml gives this same file to both the `backend` and `mcp`
# services, so these three keys are read by whichever process needs them.

# How the backend container reaches the mcp container: compose service name, not
# host.docker.internal (both are inside the same compose network). This matches
# the built-in default, so it could be omitted -- it's spelled out here so the
# topology is visible in the config rather than only in code.
MCP_SERVER_URL=http://mcp:9000/mcp

# 0.0.0.0, not 127.0.0.1: the mcp container must accept connections from the
# backend container. Safe because docker-compose.yml `expose`s (not
# `ports:`-publishes) 9000, so only the compose network can reach it.
MCP_HOST=0.0.0.0
MCP_PORT=9000
