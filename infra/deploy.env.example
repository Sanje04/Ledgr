# Configuration for infra/deploy.ps1 and infra/deploy.sh (see AZURE_DEPLOYMENT.md).
#
# Copy to infra/deploy.env, fill in, and keep it out of git -- it holds the Atlas
# connection string and the Tailscale OAuth secret. infra/.gitignore already
# excludes it; that is a safety net, not a licence to be careless with it.

# --- Azure ------------------------------------------------------------------
RESOURCE_GROUP=tender-rg
# Pick a region near you AND near the Atlas cluster (step 5) -- every chat turn
# makes several round trips to MongoDB, so a mismatched pair is felt directly.
LOCATION=canadacentral
ENVIRONMENT_NAME=tender-env

# --- Images (pushed by .github/workflows/ci.yml to GHCR) --------------------
# Your GitHub account name, lowercased. GHCR paths reject uppercase.
GHCR_OWNER=your-github-username
# Which tag to deploy. Prefer an immutable commit SHA over "latest": with
# `latest`, Container Apps cannot tell one revision's image from another's, so a
# rollback has nothing distinct to roll back to.
IMAGE_TAG=latest

# --- MongoDB Atlas M0 (step 5) ---------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ag_ai

# --- Ollama on the home machine, over the tailnet (step 4) -----------------
# The MagicDNS name of the machine running Ollama. tailscaled resolves this, so
# nothing else in the deployment needs to know what it means.
OLLAMA_BASE_URL=http://your-ollama-host.your-tailnet.ts.net:11434
OLLAMA_MODEL=gemma4:latest

# --- Tailscale OAuth client (step 4) ---------------------------------------
# Admin console -> Settings -> OAuth clients. Needs the auth_keys write scope and
# the tag:tender-backend tag. The tag must also appear in the tailnet ACL's
# tagOwners, or registration fails with a permissions error.
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_HOSTNAME=tender-backend-azure

# --- Backend behaviour ------------------------------------------------------
# Recent conversation turns replayed to the model per request (backend specs
# Phase 7). 0 disables history.
MAX_HISTORY_TURNS=5
