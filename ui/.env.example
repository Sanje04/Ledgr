# Backend chat endpoint.
# Example: VITE_API_URL=https://api.example.com/api/chat
VITE_API_URL=http://127.0.0.1:8000/api/chat

# Backend transactions endpoint (read-only; the /import suffix is derived from
# it, not configured separately). Set this together with VITE_API_URL above --
# nothing enforces the pair, so setting only one points chat and the dashboard
# at different places.
# Example: VITE_TRANSACTIONS_API_URL=https://api.example.com/api/transactions
VITE_TRANSACTIONS_API_URL=http://127.0.0.1:8000/api/transactions

# Run against built-in sample data with no backend at all. Opt-in only: with
# this unset and the URLs above missing, the app shows an error rather than
# silently rendering fake accounts. CSV import is unavailable in this mode, so
# the Upload and Preview screens can't be exercised here -- point at a real
# backend for those.
# VITE_USE_MOCK_DATA=true
