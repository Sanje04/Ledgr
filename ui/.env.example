# Backend chat endpoint. Leave unset to use the built-in mock bot.
# Example: VITE_API_URL=https://api.example.com/api/chat
VITE_API_URL=http://127.0.0.1:8000/api/chat

# Backend transactions endpoint (read-only, used by TransactionsPanel). Set
# together with VITE_API_URL above -- leaving only this one unset means the
# panel silently falls back to mock data while chat talks to the real backend.
# Example: VITE_TRANSACTIONS_API_URL=https://api.example.com/api/transactions
VITE_TRANSACTIONS_API_URL=http://127.0.0.1:8000/api/transactions
